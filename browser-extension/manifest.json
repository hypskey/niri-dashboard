{
  "manifest_version": 2,
  "name": "NiriDashboard active-tab icons",
  "version": "0.2.0",
  "description": "Report active-tab hostnames locally to NiriDashboard.",
  "browser_specific_settings": {
    "gecko": {
      "id": "niridashboard-tabs@local"
    }
  },
  "permissions": [
    "tabs",
    "http://127.0.0.1/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:47831"
}
